# ── LLM Provider Configuration ────────────────────────────────────────────────
# Mode options:
#   auto       - Try primary cloud API (OpenRouter/OpenAI/Gemini); if offline or unavailable,
#                automatically fall back to local Ollama; if Ollama is not running,
#                fall back to self-contained deterministic heuristics.
#   openrouter - Enforce OpenRouter cloud API
#   ollama     - Enforce local Ollama running at OLLAMA_BASE_URL
#   openai     - Enforce official OpenAI API
#   gemini     - Enforce Google Gemini API
LLM_PROVIDER=auto

# ── Cloud LLM: OpenRouter (Primary) ───────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_LIGHT_MODEL=openai/gpt-4o-mini

# ── Local LLM: Ollama (Local Fallback or Offline Mode) ────────────────────────
# Connects to local Ollama daemon if installed/running
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_LIGHT_MODEL=llama3.2

# ── Optional Legacy Cloud Keys ────────────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_PATH=./invoices.db

# ── Qdrant Vector Database ────────────────────────────────────────────────────
# Mode options:
#   auto   - Try Qdrant Cloud (QDRANT_URL); if unavailable, try local Qdrant server
#            (http://localhost:6333); if not installed, fall back to embedded in-memory (:memory:)
#   cloud  - Enforce Qdrant Cloud cluster
#   local  - Enforce local Qdrant server (QDRANT_LOCAL_URL)
#   memory - Enforce embedded local in-memory/disk vector store (zero installation required)
QDRANT_MODE=auto

# Qdrant Cloud Cluster
QDRANT_URL=https://your-cluster-id.region.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=invoice_schema_fields

# Local Qdrant Configuration
QDRANT_LOCAL_URL=http://localhost:6333
QDRANT_LOCAL_PATH=./qdrant_storage
